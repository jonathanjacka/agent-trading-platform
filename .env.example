# TODO: Populate with your API keys and environment variables

# Environment
NODE_ENV=development

# Security - Required for production!
# Generate with: openssl rand -hex 32
API_SECRET=

# OpenAI API
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# Pushover Notifications (optional but recommended)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Brave Search API
BRAVE_API_KEY=

# Polygon/Massive Market Data API
POLY_API_KEY=

# Automated Trading Scheduler
ENABLE_SCHEDULER=true
TRADING_SCHEDULE=0 6 * * 1-5
SCHEDULER_TIMEZONE=UTC

# Client URL (for CORS - set to your Netlify URL in production)
CLIENT_URL=

# Database path (defaults to ./data/trading.db)
# For Railway, set to the volume mount path, e.g., /app/data/trading.db
DATABASE_PATH=

# CI/CD
CODECOV_TOKEN=

# Observability - Langfuse (optional but recommended)
# Get keys from https://cloud.langfuse.com or https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com