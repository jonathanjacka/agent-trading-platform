{
  "name": "agent-trading-platform",
  "version": "1.0.0",
  "description": "Under construction...",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "dev:test-market": "tsx src/test-market-data.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test-api": "bash test-api.sh"
  },
  "imports": {
    "#/*": "./src/*",
    "#types/*": "./src/types/*",
    "#utils/*": "./src/utils/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanjacka/agent-trading-platform.git"
  },
  "keywords": [
    "trading",
    "platform",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jonathanjacka/agent-trading-platform/issues"
  },
  "homepage": "https://github.com/jonathanjacka/agent-trading-platform#readme",
  "dependencies": {
    "@ai-sdk/openai": "^2.0.65",
    "@massive.com/client-js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "ai": "^5.0.92",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "node-cron": "^4.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "eslint": "^9.16.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^4.0.14"
  }
}
